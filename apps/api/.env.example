# Local development (SQLite, zero-setup)
DATABASE_URL="file:./dev.db"
JWT_SECRET="demo-secret-change-me"
PORT=3000

# Production (Render injects DATABASE_URL/JWT_SECRET via render.yaml):
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# CORS — comma-separated allowed origins (unset = reflect any origin, dev only)
# CORS_ORIGINS="https://your-app.netlify.app"

# Error tracking (optional)
# SENTRY_DSN="https://...ingest.sentry.io/..."

# Durable media storage (S3 or S3-compatible like Cloudflare R2 / MinIO).
# When unset, uploads fall back to local disk (NOT persistent on most hosts).
# S3_BUCKET="my-booking-media"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # R2/MinIO only
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_PUBLIC_URL="https://cdn.example.com"                     # public base URL

# Demo seed guard: "false" disables seeding; "force" overwrites existing data.
# Production deploys should NOT auto-seed (build omits it). Seed once manually.
# SEED_DEMO="force"
